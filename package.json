{
  "name": "godot4-step-by-step",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Пошаговое руководство по Godot 4 на русском языке — SPA с интерактивным прогрессом и векторными диаграммами.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "verify:godot": "node scripts/verify-godot-examples.mjs",
    "verify:errors": "node scripts/verify-error-messages.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:manifest": "node scripts/generate-stage-manifest.mjs --check",
    "verify:size": "node scripts/measure-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run verify:godot && npm run verify:errors && npm run verify:links && npm run verify:manifest && npm run build && npm run verify:size"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5"
  }
}
